# ---------------------------------------------------------------------------
# MorphMetric — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env. NEVER expose any of these to the frontend
# (no NEXT_PUBLIC_ prefix on secrets).
# ---------------------------------------------------------------------------

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Prisma / PostgreSQL) — required once persistence is wired up.
DATABASE_URL="postgresql://user:password@localhost:5432/morphmetric?schema=public"

# Auth (server-side only)
AUTH_SECRET="change-me-to-a-long-random-string"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Private object storage for face photos (S3-compatible).
# Images are stored privately, accessed only via short-lived signed URLs,
# and deleted after IMAGE_RETENTION_HOURS.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="morphmetric-uploads"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
IMAGE_RETENTION_HOURS="24"

# AI / vision provider (server-side only).
# The app talks to these through lib/ai — swapping providers must not require
# touching the rest of the codebase.
VISION_PROVIDER="heuristic"     # heuristic | mediapipe | cloud
AI_PROVIDER_API_KEY=""

# Security
RATE_LIMIT_PER_MINUTE="12"

# Billing (deferred — MVP does not require Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
