# ---------------------------------------------------------------------------
# MorphMetric — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env. NEVER expose a secret to the frontend: only
# NEXT_PUBLIC_* reaches the browser, and nothing secret may carry that prefix.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Prisma / PostgreSQL) ----------------------------------------
# Required for accounts. Without it the product still runs, but sign-up and
# login are disabled and the scan quota cannot be enforced.
DATABASE_URL="postgresql://user:password@localhost:5432/morphmetric?schema=public"
# A pooled connection breaks `prisma migrate deploy`. If your provider gives a
# direct/unpooled URL (Neon does), put it here — the predeploy script prefers it.
DIRECT_URL=""

# --- Auth (server-side only) -----------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Transactional email ---------------------------------------------------
# Without these, password-reset emails are logged to the server console
# instead of being sent — which means a user who forgets their password is
# locked out for good. Set them before launch.
RESEND_API_KEY=""
EMAIL_FROM="MorphMetric <noreply@your-domain.com>"

# --- Security --------------------------------------------------------------
RATE_LIMIT_PER_MINUTE="12"

# --- Billing ---------------------------------------------------------------
# Leave false until Stripe checkout works end to end. While it is false every
# plan is unlocked for everyone, because showing locked features nobody can
# buy is worse than showing them unlocked.
NEXT_PUBLIC_BILLING_LIVE="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""

# ---------------------------------------------------------------------------
# Deliberately absent: there are no image-storage or vision-provider keys.
# Face detection runs entirely in the browser and no photograph is ever
# uploaded, so there is no bucket to configure and no API key to leak.
# ---------------------------------------------------------------------------
